{
  "name": "sudoku-pro",
  "version": "1.18.0",
  "private": true,
  "type": "module",
  "scripts": {
    "budget": "node scripts/budget.mjs",
    "build": "nuxt build",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev": "TMPDIR=/tmp nuxt dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate": "nuxt generate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:all": "pnpm check && pnpm test:e2e && pnpm visual",
    "test:e2e": "playwright test",
    "test:prod": "pnpm wavedash:build && playwright test -c playwright.prod.config.ts",
    "typecheck": "nuxt typecheck",
    "visual": "docker run --rm --init --platform linux/amd64 -v \"$PWD\":/work -v /work/.nuxt -v /work/.data -v \"sudoku-visual-nm-$(pwd | cksum | cut -d' ' -f1)\":/work/node_modules -v sudoku-visual-pnpm-store:/root/.pnpm-store -w /work -e HOST_UID=\"$(id -u)\" -e HOST_GID=\"$(id -g)\" mcr.microsoft.com/playwright:v1.65.1-noble bash scripts/visual-docker.sh",
    "visual:run": "VISUAL_REGRESSION=1 playwright test --project=visual --project=visual-mobile",
    "visual:update": "pnpm visual --update-snapshots=changed",
    "wavedash": "pnpm wavedash:build && wavedash build push",
    "wavedash:build": "WAVEDASH=1 NUXT_APP_CDN_URL=./ nuxt generate && NUXT_APP_CDN_URL=./ node scripts/budget.mjs",
    "wavedash:release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "canvas-confetti": "^1.9.4",
    "driver.js": "^1.14.0",
    "nuxt": "^4.6.4",
    "three": "^0.187.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vueuse/nuxt": "^14.4.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
