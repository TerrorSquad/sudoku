{
  "name": "sudoku-pro",
  "version": "1.9.1",
  "private": true,
  "type": "module",
  "scripts": {
    "budget": "node scripts/budget.mjs",
    "build": "nuxt build",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev": "TMPDIR=/tmp nuxt dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate": "nuxt generate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:all": "pnpm check && pnpm test:e2e && pnpm visual",
    "test:e2e": "playwright test",
    "typecheck": "nuxt typecheck",
    "visual": "docker run --rm --init -v \"$PWD\":/work -v sudoku-visual-node-modules:/work/node_modules -v sudoku-visual-pnpm-store:/root/.pnpm-store -w /work -e HOST_UID=\"$(id -u)\" -e HOST_GID=\"$(id -g)\" mcr.microsoft.com/playwright:v1.64.1-noble bash scripts/visual-docker.sh",
    "visual:update": "pnpm visual --update-snapshots=changed",
    "visual:run": "VISUAL_REGRESSION=1 playwright test --project=visual --project=visual-mobile",
    "wavedash": "WAVEDASH=1 NUXT_APP_BASE_URL=./ nuxt generate && node scripts/budget.mjs && wavedash build push",
    "wavedash:release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "canvas-confetti": "^1.9.4",
    "nuxt": "^4.6.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@vite-pwa/nuxt": "^1.1.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
