{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "TMPDIR=/tmp nuxt dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate": "nuxt generate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "visual": "VISUAL_REGRESSION=1 playwright test --project=visual --project=visual-mobile",
    "visual:report": "playwright show-report",
    "visual:update": "VISUAL_REGRESSION=1 playwright test --project=visual --project=visual-mobile --update-snapshots=changed"
  },
  "dependencies": {
    "@nuxt/ui": "^4.8.2",
    "@nuxtjs/i18n": "^10.4.0",
    "canvas-confetti": "^1.9.4",
    "nuxt": "^4.4.6",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.0",
    "@types/canvas-confetti": "^1.9.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "vitest": "^4.1.8"
  }
}
